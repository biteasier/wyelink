<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Default browser status -->
        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Desc"
                android:text="@string/status_desc" />

            <Button
                android:id="@+id/set_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_browsers" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/browser1" />

            <TextView
                style="@style/Desc"
                android:text="@string/browser1_desc" />

            <Spinner
                android:id="@+id/browser1"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:text="@string/browser2" />

            <TextView
                style="@style/Desc"
                android:text="@string/browser2_desc" />

            <Spinner
                android:id="@+id/browser2"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_smart" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/smart"
                style="@style/Toggle"
                android:text="@string/smart" />

            <TextView
                style="@style/Desc"
                android:text="@string/smart_desc" />

            <Switch
                android:id="@+id/custom_tabs"
                style="@style/Toggle"
                android:layout_marginTop="12dp"
                android:text="@string/custom_tabs" />

            <TextView
                style="@style/Desc"
                android:text="@string/custom_tabs_desc" />

            <Switch
                android:id="@+id/toast"
                style="@style/Toggle"
                android:layout_marginTop="12dp"
                android:text="@string/toast" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_rules" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/rules1" />

            <EditText
                android:id="@+id/rules1"
                style="@style/RulesBox"
                android:hint="@string/rules1_hint" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="16dp"
                android:text="@string/rules2" />

            <EditText
                android:id="@+id/rules2"
                style="@style/RulesBox"
                android:hint="@string/rules2_hint" />

            <TextView
                style="@style/Desc"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="@string/rules_help"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_test" />

        <LinearLayout style="@style/Card">

            <EditText
                android:id="@+id/test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/test_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/section_recent" />

            <TextView
                android:id="@+id/clear_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:text="@string/clear"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/history"
                style="@style/Toggle"
                android:text="@string/history" />

            <TextView
                style="@style/Desc"
                android:layout_marginBottom="10dp"
                android:text="@string/history_desc" />

            <TextView
                android:id="@+id/recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
